# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://nk-enterprises.vercel.app

# Database & Security Secrets
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nk_enterprises?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key_2026

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
